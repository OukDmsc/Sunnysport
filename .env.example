# Local database. PostgreSQL is also supported; update provider in schema.prisma.
DATABASE_URL="file:./dev.db"

# Production PostgreSQL (Supabase): set these in Vercel, not in this local file.
# Replace DATABASE_URL in the production environment with the Supabase pooled URL.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
# Use the Supabase direct connection URL for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Generate a unique random value, at least 32 characters long.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-local-password"

# Customer password recovery email provider: resend, smtp, or infobip.
EMAIL_PROVIDER="resend"
# Canonical sender address. Existing deployments may use RESEND_FROM_EMAIL for
# Resend or SMTP_FROM for SMTP; Infobip email uses INFOBIP_FROM_EMAIL.
EMAIL_FROM="SUNNY SPORT CLUB <password-reset@your-verified-domain.com>"

# Infobip API hostname (hostname only; used by Infobip email and SMS).
INFOBIP_BASE_URL="your-account.api.infobip.com"
INFOBIP_API_KEY=""
# Infobip email sender (only needed with EMAIL_PROVIDER=infobip).
INFOBIP_FROM_EMAIL="password-reset@your-verified-domain.com"

# Resend email (only needed with EMAIL_PROVIDER=resend).
RESEND_API_KEY=""

# SMTP email (only needed with EMAIL_PROVIDER=smtp).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-password"

# Customer SMS provider: infobip or twilio. Cambodia number formatting is normalized to +855.
SMS_PROVIDER="infobip"
INFOBIP_SENDER="your-approved-sender-id"

# Optional Twilio alternative (only needed with SMS_PROVIDER=twilio).
TWILIO_ACCOUNT_SID="AC00000000000000000000000000000000"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_PHONE_NUMBER="+15555550100"
TWILIO_SMS_ENABLED="false"

# Optional Telegram Bot API integration. Add the bot to your group and use the
# numeric group chat ID returned by scripts/get-telegram-group-chat-id.ps1.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_GROUP_CHAT_ID=""

# Manual payment mode only. Dynamic KHQR merchant details allow each booking's
# full price after the flat $2.50 discount to be encoded in the QR. Choose the
# currency supported by your merchant account; KHR uses USD_TO_KHR_RATE.
KHQR_BAKONG_ACCOUNT_ID=""
KHQR_MERCHANT_ID=""
KHQR_MERCHANT_NAME=""
KHQR_MERCHANT_CITY="Phnom Penh"
KHQR_ACQUIRING_BANK=""
KHQR_CURRENCY=""
KHQR_EXPIRY_MINUTES="60"

# Optional legacy fallback settings. A static image or generic payment link
# does not automatically include the booking amount. No payment is auto-confirmed.
KHQR_IMAGE_URL=""
KHQR_PAYMENT_URL=""
KHQR_PAYMENT_INSTRUCTIONS="Scan the official merchant KHQR and include your booking reference in the payment note."
USD_TO_KHR_RATE="4100"
