# Copy this file to vanilla-js/.env and replace placeholders privately.
# Relative to prisma/schema.prisma, this reuses the existing SQLite database.
DATABASE_URL="file:../../prisma/dev.db"
SESSION_SECRET="replace-with-a-random-value-at-least-32-characters"
ADMIN_USERNAME="replace-me"
ADMIN_PASSWORD="replace-me"
PORT=3001
NODE_ENV=development
USD_TO_KHR_RATE=4100

# Optional manual KHQR display only; no payment is automatically collected.
KHQR_IMAGE_URL=""
KHQR_PAYMENT_URL=""
KHQR_PAYMENT_INSTRUCTIONS="Pay the required 10% deposit using the KHQR link. Check the amount before paying and include your booking reference."

# Optional Telegram booking notifications / test-message action.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional password recovery delivery. Select a provider explicitly.
EMAIL_PROVIDER=""
EMAIL_FROM=""
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
INFOBIP_BASE_URL=""
INFOBIP_API_KEY=""
INFOBIP_FROM_EMAIL=""

SMS_PROVIDER=""
INFOBIP_SMS_SENDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
